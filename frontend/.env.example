# Base URL of the MyLumi inference API (backend/).
#
# Copy this file to .env.local to run against a local backend. The value below
# is the local default and is what `backend/` serves on by default.
#
# Local:  http://localhost:8000
# Render: https://mylumi-api.onrender.com
#
# Leaving this empty is supported - the app runs with no network calls at all -
# but the insights and journal sections will then say they are not configured
# rather than rendering findings. That is a deliberate build choice, not a bug;
# if you expected cards and got that message, this is the setting to fix.
VITE_API_URL=http://localhost:8000
